# Wallet-owned Birth deployment byte-verified on Betanet on 2026-10-08.
VITE_CAMBRIAN_PROGRAM_ID=taLnTXq4qblEsC-HkN4QG35Lp72Vnle8gk8UkiAtASymFD
VITE_CAMBRIAN_ABI_ID=taPciIseW9AzTnNaB6VJyhHkiOwEDfZYwUbdPdfvbvUQuS
# Set false to pause new Births. Keep false for unverified program/ABI overrides.
VITE_CAMBRIAN_WALLET_BIRTH_ENABLED=true
VITE_THRU_RPC_URL=https://rpc.betanet.thru.org
VITE_THRU_WALLET_IFRAME_URL=https://app.tid.sh/embedded
VITE_THRU_EXPLORER_URL=https://scan.thru.org
VITE_API_URL=

# API-only faucet settings. Keep provider credentials out of the frontend.
API_PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=false
FAUCET_AMOUNT_UNITS=
FAUCET_COOLDOWN_MS=86400000
FAUCET_RATE_WINDOW_MS=3600000
FAUCET_RATE_MAX=3
FAUCET_PROVIDER_URL=
FAUCET_PROVIDER_TOKEN=
FAUCET_PROVIDER_TIMEOUT_MS=10000

# Optional local-only provider. Set FAUCET_CLI_ENABLED=true to use the
# already configured Thru CLI signer instead of FAUCET_PROVIDER_URL.
FAUCET_CLI_ENABLED=false
FAUCET_CLI_PATH=thru.cmd
FAUCET_CLI_RPC_URL=https://rpc.betanet.thru.org
FAUCET_CLI_FEE_PAYER=default
FAUCET_CLI_TIMEOUT_MS=15000
