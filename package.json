{
  "name": "cambrian-dapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1",
    "api:dev": "npm --workspace @cambrian/api run dev",
    "api:typecheck": "npm --workspace @cambrian/api run typecheck",
    "build": "vite build apps/web",
    "test": "node --test --experimental-strip-types --import ./tests/register-typescript.mjs tests/cambrian-sdk.test.ts tests/birth-flow.test.ts tests/read-service.test.ts tests/faucet.test.ts tests/local-wallet.test.ts",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "preview": "vite preview apps/web --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@thru/sdk": "^0.4.1",
    "@thru/wallet": "^0.4.1",
    "@types/three": "^0.186.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
